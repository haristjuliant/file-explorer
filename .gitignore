# Dependencies and build output
node_modules/
dist/
src-tauri/target/

# Generated by tauri-build
src-tauri/gen/

# Editor and OS noise
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*

# Credentials. Nothing here has ever been committed -- this is a guard so that
# an .env dropped in for a quick test cannot be picked up by `git add -A`.
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.jks
.npmrc
.netrc
secrets.json
credentials.json
*.token

# NOTE: release/ is deliberately NOT ignored -- the shipped installer and
# portable executable are committed so they can be downloaded straight from
# the repository. Future builds belong in a GitHub Release instead of here,
# to keep them out of the git history.
