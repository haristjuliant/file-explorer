<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- Without this, OUR OWN Win32 calls stay capped at MAX_PATH even on a
           long-path-enabled system (std::fs handles long paths on its own). -->
